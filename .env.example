# Copy to .env before running docker compose: cp .env.example .env
# Local development values only. Never commit .env or reuse these anywhere real.

# PostgreSQL: trades, breaks, resolutions
POSTGRES_USER=settlement
POSTGRES_PASSWORD=settlement-dev
POSTGRES_DB=settlement

# MongoDB: audit store
MONGO_USER=settlement
MONGO_PASSWORD=settlement-dev

# Running the app or tests on your machine, outside Docker. Compose sets its own
# values for the app container, using service names instead of localhost.
DATABASE_URL=postgresql://settlement:settlement-dev@localhost:5432/settlement
REDIS_URL=redis://localhost:6379/0
